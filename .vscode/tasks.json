{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docsexprime: start server 8080",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe",
            "args": [
                "-m",
                "uvicorn",
                "server:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8080"
            ],
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": {
                "owner": "uvicorn",
                "pattern": {
                    "regexp": "^(ERROR|WARNING):\\s+(.*)$",
                    "severity": 1,
                    "message": 2
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Started server process",
                    "endsPattern": "Uvicorn running on"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
